{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drawpaper",
  "version": "0.1.0-rc.25",
  "identifier": "com.drawpaper.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../packages/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../../packages/web build",
    "frontendDist": "../../../packages/web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "drawpaper",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Visible",
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost; script-src 'self'; connect-src 'self' https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "drawpaper contributors",
    "copyright": "MIT",
    "shortDescription": "Local-first infinite-canvas knowledge-block note tool",
    "longDescription": "drawpaper is a local-first, infinite-canvas knowledge-block note tool. This bundle is the Windows desktop shell (Tauri 2 + WebView2). All data stays on-device; no account, no cloud sync.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      },
      "wix": {
        "version": "0.1.0.25",
        "language": [
          "en-US",
          "zh-CN"
        ]
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "ext": [
          "kbnote"
        ],
        "name": "drawpaper knowledge-block note",
        "description": "drawpaper knowledge-block note (.kbnote)",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0RTkwNkFCOUQ4M0YxM0MKUldRODhZT2Rxd2JwOU9kOTZILzlLanJsbEVSWUJCaEJWSmZnUkRjUElyc2VkNjV0VzBtOGpCdTMK",
      "endpoints": [
        "https://github.com/guzifeng123/drawpaper--freedom/releases/latest/download/latest.json"
      ]
    }
  }
}
